# Скопировать в .env и заполнить

# ═══ Обычная схема: один сервер ходит к модели напрямую ═══

# вариант 1 — через Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# вариант 2 — через OpenRouter
# ANTHROPIC_API_KEY=sk-or-v1-...
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# MODEL=anthropic/claude-opus-5
# PROVIDER=Anthropic

# пароль на вход для команды
ACCESS_PASSWORD=придумайте-пароль


# ═══ Схема с релеем: когда до модели не дотянуться напрямую ═══
#
# Два экземпляра одного и того же приложения.
#
# ДАЛЬНИЙ (там, где доступна модель) — добавить к переменным выше:
# RELAY_ACCEPT=длинный-пароль-для-релея
#
# БЛИЖНИЙ (там, куда попадают люди) — ключ модели не нужен:
# RELAY_TO=https://адрес-дальнего-сервера
# RELAY_PASSWORD=длинный-пароль-для-релея
# ACCESS_PASSWORD=пароль-для-команды
