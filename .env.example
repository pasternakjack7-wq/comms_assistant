# Скопировать в .env и заполнить

# ── вариант 1: напрямую через Anthropic ──
ANTHROPIC_API_KEY=sk-ant-...

# ── вариант 2: через OpenRouter, с закреплением провайдера ──
# ANTHROPIC_API_KEY=sk-or-v1-...
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# MODEL=anthropic/claude-sonnet-4.6      точное имя смотрите на openrouter.ai/models
# PROVIDER=Anthropic                     запрос пойдёт только к Anthropic, без подмены

# пароль на вход для команды
ACCESS_PASSWORD=придумайте-пароль
